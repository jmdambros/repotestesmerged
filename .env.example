# Backend Python (FastAPI) usado pelas rotas /api do Next: cadastro, login,
# assinatura e transcrição.
SOPHIA_BACK_URL=http://localhost:8000
NEXT_PUBLIC_SOPHIA_TRANSCRICAO=http://localhost:8000

# Segredo que assina o cookie de sessão (HMAC). Obrigatório em produção; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, em desenvolvimento cada reinício do `next dev` encerra as sessões.
SESSION_SECRET=

# Base REST dos casos quando o backend tiver essas rotas. Sem esta variável os
# casos rodam no mock (já isolados por usuário). Ex.: http://localhost:8000
NEXT_PUBLIC_API_URL=

# Análise preliminar e chat com IA real (backend: módulo `analise`, chave só no servidor).
# Sem esta variável, análise e chat continuam em demonstração (mock).
NEXT_PUBLIC_ANALISE_REAL=
