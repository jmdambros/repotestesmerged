# Copie este arquivo para backend/.env e preencha localmente.
# Não coloque usuário, senha ou URI real neste exemplo.
MONGODB_URI=
GROQ_API_KEY=

# IA da análise preliminar e do chat (chave só no servidor, nunca no navegador).
# Provedor: groq (padrão) | openai | anthropic | google. A chave é <PROVEDOR>_API_KEY.
SOPHIA_LLM_PROVIDER=groq
# GROQ_API_KEY já está acima. Para outro provedor: OPENAI_API_KEY, ANTHROPIC_API_KEY ou GOOGLE_API_KEY.
# Modelos são configuração (provedores descontinuam modelos): SOPHIA_MODEL_GROQ, SOPHIA_MODEL_OPENAI, ...
# Banco local das análises (provisório) e pasta das minutas .docx:
# SOPHIA_DB_PATH=sophia_analises.db
# SOPHIA_OUTPUT_DIR=generated_docs
